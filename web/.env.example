# Supabase projesi: Settings > Database ve API
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=   # isteğe bağlı; boşsa LLM'siz kural tabanlı mod
DEV_USER_ID=   # geçici: Supabase Auth bağlanana kadar bir UUID
SUPABASE_SERVICE_ROLE_KEY=   # yalnızca /api/radar için, asla istemciye verme
RESEND_API_KEY=
RADAR_FROM=   # doğrulanmış gönderen adresi
CRON_SECRET=   # /api/radar için rastgele uzun değer
OPENALEX_MAILTO=   # OpenAlex nazik havuz için e-postan
ADMIN_EMAILS=   # /yonetim kuyruğunu çözebilecek e-postalar, virgülle
BOT_USER_AGENT=CalismaninYoluBot/1.0 (+iletişim adresin)

# 1 = kayıtta e-posta onayı beklenmez (yalnızca demo)
DEMO_HIZLI_KAYIT=

# OpenAlex ücretsiz anahtarı (data/scripts içe aktarma betikleri için). Anahtarsız günlük kota ~1000 istektir ve ağ başına paylaşılır.
OPENALEX_API_KEY=
